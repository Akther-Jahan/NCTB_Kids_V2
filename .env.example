EXPO_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=YOUR_PUBLIC_ANON_KEY
# Remote Supabase curriculum is the release default. Set this to false only
# when intentionally testing curriculum.ts in local development.
EXPO_PUBLIC_USE_REMOTE_CURRICULUM=true
EXPO_PUBLIC_PRIVACY_POLICY_URL=https://YOUR_PUBLIC_SITE/privacy
EXPO_PUBLIC_ACCOUNT_DELETION_URL=https://YOUR_PUBLIC_SITE/delete-account
EXPO_PUBLIC_PASSWORD_RESET_REDIRECT_URL=nctbkids://reset-password
EXPO_PUBLIC_API_BASE_URL=
